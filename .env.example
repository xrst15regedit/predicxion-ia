# Plantilla pública. No contiene credenciales reales.
# Copia este archivo como .env en desarrollo local.

# Aplicación
FLASK_ENV=production
DEBUG=false
PORT=5000
SECRET_KEY=

# Firebase / Firestore
FIREBASE_CREDENTIALS_PATH=/ruta/segura/firebase-service-account.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Football-Data.org
FOOTBALL_API_URL=https://api.football-data.org/v4/matches
FOOTBALL_API_KEY=
FOOTBALL_DATA_API_KEY=
CALENDAR_LOOKAHEAD_DAYS=45
CALENDAR_BACKFILL_DAYS=7

# API-Sports / API-Football
API_SPORTS_KEY=
API_SPORTS_HOST=v3.football.api-sports.io

# Proveedores secundarios
SOFASCORE_ENABLED=true
ESPN_ENABLED=true
ESPN_API_KEY=

# Inteligencia artificial
API_KEY_GEMINI=
GEMINI_API_KEY=
API_KEY_GROQ=
DEEPSEEK_API_KEY=

# OAuth
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Mercado Pago
MP_ACCESS_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Seguridad y administración
API_HMAC_SECRET=
AUDIT_SALT=
OWNER_EMAILS=
ADMIN_EMAILS=

# Worker y caché
DISABLE_BACKGROUND_WORKERS=false
DISABLE_FIREBASE_INIT=false
ENRICHMENT_WORKER_ENABLED=true
ENRICHMENT_CACHE_TTL=3600
ALLOW_SIMULATED_ACTA=false
